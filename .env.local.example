# From Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role — server only, KEEP SECRET
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Ønskebrønnen (/onske) — to hemmeligheter:
# ONSKE_OWNER_KEY er passordet ditt for å åpne brønnen som eier.
# ONSKE_SECRET signerer eier-cookien og reservasjons-kvitteringene.
# Begge kan falle tilbake på WISHLIST_ADMIN_KEY hvis du vil.
ONSKE_OWNER_KEY=pick-a-long-random-string
ONSKE_SECRET=pick-another-long-random-string

# --- Krystallkulen (/fpl) ---
# Nøkkel for den planlagte kjøringen på /api/fpl/snapshot. Valgfri, men uten den
# svarer endepunktet 401. På Vercel settes CRON_SECRET i stedet, og plattformen
# sender den selv som Authorization-header.
FPL_CRON_KEY=pick-another-long-random-string

# Laget den planlagte kjøringen skal fryse prognosen for. Valgfri.
FPL_ENTRY_ID=5991938
